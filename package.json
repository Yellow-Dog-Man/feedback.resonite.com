{
	"name": "site",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"types": "wrangler types --env-file .dev.vars.example --strict-vars=false",
		"typecheck": "tsc -p tsconfig.json && tsc -p src/frontend/tsconfig.json",
		"preview": "npm run build && npx wrangler dev",
		"deploy": "npm run build && wrangler d1 migrations apply feedback-db --remote && wrangler deploy",
		"db:migrate:local": "wrangler d1 migrations apply feedback-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply feedback-db --remote",
		"db:migration:create": "wrangler d1 migrations create feedback-db",
		"format": "npx @biomejs/biome format --write",
		"lint": "npx @biomejs/biome lint --write",
		"check": "npx @biomejs/biome check --write"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@cloudflare/vite-plugin": "^1.54.8",
		"@cloudflare/workers-types": "^5.20261003.1",
		"@types/mustache": "^4.2.6",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"wrangler": "^4.131.1"
	},
	"dependencies": {
		"@hono-rate-limiter/cloudflare": "^0.2.2",
		"@hono/zod-validator": "^0.9.1",
		"@octokit/app": "^16.1.4",
		"formsmd": "^1.1.3",
		"hono": "^4.7.2",
		"hono-rate-limiter": "^0.5.4",
		"mustache": "^4.2.0",
		"obscenity": "^0.4.6",
		"tinyld": "^1.3.4",
		"vite-ssr-components": "^0.6.1",
		"zod": "^4.6.5"
	},
	"overrides": {
		"@cloudflare/workers-types": "$@cloudflare/workers-types"
	}
}
