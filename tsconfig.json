{
	// Worker (backend) and shared code. The browser code has its own
	// src/frontend/tsconfig.json, so neither side sees the other's globals.
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowJs": true,
		"allowImportingTsExtensions": true,
		"lib": ["ESNext"],
		"types": ["vite/client"],
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx"
	},
	"include": [
		"worker-configuration.d.ts",
		"src/backend",
		"src/shared",
		"src/config"
	]
}
